
<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- Application -->
	<app
		title="Friday Night Funkin'"
		file="Funkin"
		packageName="com.ninjamuffin99.funkin"
		main="Main"
		version="0.2.7"
		company="ninjamuffin99"
		preloader="flixel.system.FlxPreloader"
	/>

	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- Window -->
	<window
		width="1280"
		height="720"
		fps="60"
		background="#000000"
		hardware="true"
		vsync="false"
	/>

	<window if="html5" resizable="true" />

	<window
		if="desktop"
		orientation="landscape"
		fullscreen="false"
		resizable="true"
	/>

	<window
		if="mobile"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
	/>

	<window
		if="switch"
		orientation="landscape"
		fullscreen="true"
		width="0"
		height="0"
		resizable="true"
	/>

	<!-- Build paths -->
	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bit" />

	<classpath name="source" />

	<!-- Assets -->
<!-- Assets -->
	<assets path="assets/images" />
	<assets path="assets/data" />
	<assets path="assets/fonts" embed="true" />

	<assets path="assets/music" include="*.ogg" unless="web" />
	<assets path="assets/music" include="*.mp3" if="web" />

	<assets path="assets/sounds" include="*.ogg" unless="web" />
	<assets path="assets/sounds" include="*.mp3" if="web" />

	<assets path="assets/songs" />

	<assets path="example_mods" rename="mods" embed="false" />

	<assets path="CHANGELOG.md" />

	<!-- Libraries -->
	<haxelib name="flixel" />
	<haxedev set="webgl" />

	<haxelib name="flixel-addons" />
	<haxelib name="hscript" />
	<haxelib name="flixel-ui" />
	<haxelib name="newgrounds" />
	<haxelib name="faxe" if="switch" />
	<haxelib name="polymod" />

	<!-- Platform-specific input optimisations -->
	<haxedef name="FLX_NO_MOUSE" if="mobile" />
	<haxedef name="FLX_NO_KEYBOARD" if="mobile" />
	<haxedef name="FLX_NO_TOUCH" if="desktop" />

	<!-- Core Flixel settings -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!-- Release optimisations -->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />

	<!-- Custom -->
	<icon path="art/icon.png" />

	<haxedef name="NG_LOGIN" if="newgrounds" />
</project>
