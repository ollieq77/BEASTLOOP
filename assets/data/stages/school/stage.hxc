var bgGirls:Dynamic;

function onCreate():Void
{
    // Create the background girls.
    bgGirls = Type.createInstance(
        BackgroundGirls,
        [-100, 190]
    );

    bgGirls.scrollFactor.set(0.9, 0.9);

    bgGirls.setGraphicSize(
        Std.int(bgGirls.width * daPixelZoom)
    );

    bgGirls.updateHitbox();

    // Register and add to the stage.
    api.addObject(bgGirls, "bgGirls");

    // Roses uses the scared animation.
    if (SONG.song.toLowerCase() == "roses")
        bgGirls.getScared();
}

function onBeatHit():Void
{
    if (bgGirls != null)
        bgGirls.dance();
}