
var upperBoppers:Dynamic;
var bottomBoppers:Dynamic;
var santa:Dynamic;

function onCreate():Void
{
    upperBoppers = api.getSprite("upperBoppers");
    bottomBoppers = api.getSprite("bottomBoppers");
    santa = api.getSprite("santa");
}

function onBeatHit():Void
{
    if (upperBoppers != null)
        upperBoppers.animation.play("bop", true);

    if (bottomBoppers != null)
        bottomBoppers.animation.play("bop", true);

    if (santa != null)
        santa.animation.play("idle", true);
}

function onDestroy():Void
{

}

// ---- Eggnog ends with the lights shutting off before Winter Horrorland ----

function onSongEnd(nextSong):Void
{
    if (nextSong != null && SONG.song.toLowerCase() == "eggnog")
    {
        var blackShit = api.makeSolid(
            -FlxG.width * FlxG.camera.zoom,
            -FlxG.height * FlxG.camera.zoom,
            FlxG.width * 3,
            FlxG.height * 3,
            0xFF000000
        );
        blackShit.scrollFactor.set();
        api.addToState(blackShit);

        api.camera.hud.visible = false;

        api.playSound('Lights_Shut_off');
    }
}
