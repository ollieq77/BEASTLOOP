function onCreatePost()
{
    api.loadDialogue("senpaiDialogue.txt");
}

// The default dialogue box is senpai's, so this only needs the music.
function onDialogueCreate(dialogueBox)
{
    api.playMusic('Lunchbox', 0.8, 1);
    dialogueBox.fadeOutMusicOnEnd = true;
}

// Story mode: fade in from black, then the dialogue.
function onIntro(dialogueBox):Bool
{
    if (!isStoryMode)
        return false;

    var black = api.makeSolid(-100, -100, FlxG.width * 2, FlxG.height * 2, 0xFF000000);
    black.scrollFactor.set();
    api.addToState(black);

    api.timer(0.3, function(tmr)
    {
        black.alpha -= 0.15;

        if (black.alpha > 0)
        {
            tmr.reset(0.3);
        }
        else
        {
            if (dialogueBox != null)
            {
                api.setInCutscene(true);
                api.addToState(dialogueBox);
            }
            else
                api.startCountdown();

            api.removeFromState(black);
        }
    });

    return true;
}

// Senpai -> Roses plays without a screen transition and keeps the camera.
function onSongEnd(nextSong):Void
{
    if (nextSong != null)
    {
        api.skipNextTransition = true;
        api.carryCamera = true;
    }
}
