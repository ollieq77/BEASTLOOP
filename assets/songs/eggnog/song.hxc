// Eggnog ends with the lights shutting off before Winter Horrorland.
function onSongEnd(nextSong):Void
{
    if (nextSong != null)
    {
        var blackShit = api.makeSolid(
            -FlxG.width * FlxG.camera.zoom,
            -FlxG.height * FlxG.camera.zoom,
            FlxG.width * 3,
            FlxG.height * 3,
            0xFF000000
        );
        blackShit.scrollFactor.set();
        api.addToState(blackShit);

        api.camera.hud.visible = false;

        api.playSound('Lights_Shut_off');
    }
}
