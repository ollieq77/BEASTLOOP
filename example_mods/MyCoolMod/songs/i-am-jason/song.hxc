// [timestamp, tween?, target zoom, duration in steps, easing]
var cameraZoomEvents = [
    [40414.5078, false, 1.0, 4, "linear"],
    [50984.4559, true, 0.85, 7, "sineOut"],
    [53471.5026, true, 0.95, 12, "cubeOut"],
    [55958.5492, true, 1.0, 9, "cubeOut"],
    [57046.6321, true, 0.9, 9, "cubeOut"],
    [58290.1554, true, 0.8, 9, "cubeOut"],
    [59533.6787, true, 0.85, 9, "cubeOut"],
    [60310.8808, true, 1.6, 8, "sineIn"],
    [60932.6424, true, 0.8, 6, "sineOut"],
    [80207.2538, true, 1.6, 8, "sineIn"],
    [80829.0155, true, 0.85, 7, "sineOut"],
    [90155.4404, true, 1.0, 6, "sineInOut"],
    [90777.2020, true, 0.8, 6, "sineInOut"],
    [98549.2227, true, 1.0, 8, "sineIn"],
    [99170.9844, true, 0.85, 7, "sineOut"]
];

// [timestamp, modulo, multiplier, type, offset]
var cameraModuloEvents = [
    [0, 8, 0.5, "STEP", 0],
    [9948.1865, 16, 0.5, "STEP", 0],
    [14922.2798, 16, 0.5, "STEP", 0],
    [60932.6425, 4, 1.5, "STEP", 0],
    [79585.4922, 4000, 1.0, "MEASURE", 0],
    [80829.0155, 4, 1.7, "STEP", 0],
    [90155.4404, 4000, 1.0, "MEASURE", 0],
    [90777.2021, 4, 1.8, "STEP", 0],
    [99170.9845, 4000, 1.0, "MEASURE", 0]
];

var nextAddZoom = 0;
var nextCameraZoom = 0;

var BPM = 193;
var STEPS_PER_BEAT = 4;
var STEPS_PER_MEASURE = 16;

var STEP_DURATION = 60 / (BPM * STEPS_PER_BEAT);
var STEP_MS = STEP_DURATION * 1000;

var lastSongTime = -1;
var lastModuloStep = -1;

function onCreate()
{
    nextAddZoom = 0;
    nextCameraZoom = 0;

    lastSongTime = -1;
    lastModuloStep = -1;

    trace("[I AM JASON] Song script loaded.");
}

function onUpdate(elapsed:Float)
{
    if (api.inst == null)
        return;

    var songTime = api.inst.time;

    // Handle song restarts and backwards seeking.
    if (lastSongTime >= 0 && songTime < lastSongTime)
    {
        nextAddZoom = 0;
        nextCameraZoom = 0;
        lastModuloStep = -1;
    }

    lastSongTime = songTime;

    var currentStep = Math.floor(songTime / STEP_MS);
    var currentMeasure = Math.floor(currentStep / STEPS_PER_MEASURE);

    // Find the currently active camera modulo event.
    var activeModulo = cameraModuloEvents[0];

    for (event in cameraModuloEvents)
    {
        if (songTime >= event[0])
            activeModulo = event;
        else
            break;
    }

    // Camera Modulo Change.
    // Only process once when entering a new global step.
    if (currentStep != lastModuloStep)
    {
        lastModuloStep = currentStep;

        var interval = activeModulo[1];
        var multiplier = activeModulo[2];
        var type = activeModulo[3];
        var offset = activeModulo[4];

        var shouldZoom = false;

        if (type == "STEP")
        {
            shouldZoom = ((currentStep - offset) % interval == 0);
        }
        else if (type == "MEASURE")
        {
            // Only evaluate at the beginning of a measure.
            if (currentStep % STEPS_PER_MEASURE == 0)
                shouldZoom = ((currentMeasure - offset) % interval == 0);
        }

        if (shouldZoom)
        {
            api.camera.game.zoom += 0.015 * multiplier;
            api.camera.hud.zoom += 0.03 * multiplier;
        }
    }

    // Incremental camera zoom events.
    while (nextAddZoom < addZoomEvents.length)
    {
        var event = addZoomEvents[nextAddZoom];

        if (songTime < event[0])
            break;

        api.addCameraZoom(event[1], 0);

        nextAddZoom++;
    }

    // Target camera zoom events.
    while (nextCameraZoom < cameraZoomEvents.length)
    {
        var event = cameraZoomEvents[nextCameraZoom];

        if (songTime < event[0])
            break;

        var shouldTween = event[1];
        var targetZoom = event[2];
        var durationSteps = event[3];
        var ease = event[4];

        if (shouldTween)
        {
            var durationSeconds = durationSteps * STEP_DURATION;

            api.tween(
                api.camera.game,
                {zoom: targetZoom},
                durationSeconds,
                ease
            );
        }
        else
        {
            api.camera.setZoom(targetZoom, "game");
        }

        nextCameraZoom++;
    }
}
